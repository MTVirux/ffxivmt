# This is an envsubst template, not a working file: every placeholder below is
# filled in by scripts/bootstrap/app.sh and scripts/bootstrap/redeploy.sh, which
# write the result to .env before `docker compose up`. Plain `cp env .env` leaves
# the placeholders as-is; for local dev export them and run envsubst yourself.
# Substituted vars are the ZERO_SSL_*, the private IPs and the Archive__* below.

COMPOSE_PROJECT_NAME=ffmt


ZERO_SSL_USER_EMAIL=${ZERO_SSL_USER_EMAIL}
ZERO_SSL_MAIN_DOMAIN=${ZERO_SSL_MAIN_DOMAIN}
ZERO_SSL_MONITORING_DOMAIN=${ZERO_SSL_MONITORING_DOMAIN}


# Both are empty in single-host dev.
SCYLLA_PRIVATE_IP=${SCYLLA_PRIVATE_IP}
APP_PRIVATE_IP=${APP_PRIVATE_IP}

# Whichever of the two above belongs to *this* VM - the role scripts set it
# before rendering. node_exporter binds it to stay off the public NIC.
HOST_PRIVATE_IP=${HOST_PRIVATE_IP}


Archive__Endpoint=${Archive__Endpoint}
Archive__Bucket=${Archive__Bucket}
Archive__AccessKey=${Archive__AccessKey}
Archive__SecretKey=${Archive__SecretKey}


# Operator knobs, not placeholders. ShadowMode=true records anomalies but still
# writes them to sales; set false to divert them into quarantine.
Quarantine__ShadowMode=false
Quarantine__MedianMultiplier=20
