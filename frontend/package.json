    "bson": "^7.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.100.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
